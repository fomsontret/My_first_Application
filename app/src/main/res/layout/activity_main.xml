<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:padding="16dp">
    
    <ImageView
        android:id="@+id/avatar"
        android:layout_height="@dimen/image_size"
        android:layout_width="@dimen/image_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/top_barrier"
        android:contentDescription="@string/description_post_author_avatar"
        android:src="@drawable/post_avatar_drawable"/>

    <TextView
        android:id="@+id/author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/published"
        app:layout_constraintTop_toTopOf="@id/avatar"
        app:layout_constraintStart_toEndOf="@id/avatar"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginHorizontal="@dimen/padding"
        android:singleLine="true"
        app:layout_constraintEnd_toStartOf="@id/menu"
        tools:text="@sample/posts.json/data/author"/>

    <TextView
        android:id="@+id/published"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/avatar"
        app:layout_constraintTop_toBottomOf="@id/author"
        app:layout_constraintStart_toEndOf="@id/avatar"
        android:layout_marginStart="@dimen/padding"
        tools:text="@sample/posts.json/data/published"/>

    <ImageButton
        android:id="@+id/menu"
        android:contentDescription="@string/description_post_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="wrap_content"
        android:src = "@drawable/ic_more_vert_24"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"/>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/top_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="author, published, menu"
        app:barrierDirection="bottom"/>

    <TextView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/top_barrier"
        android:layout_marginTop="@dimen/padding"
        android:autoLink="web"
        tools:text="@sample/posts.json/data/content" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottom_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="content"
        app:barrierDirection="bottom"/>

    <ImageButton
        android:id="@+id/like"
        android:contentDescription="@string/description_post_like"
        app:layout_constraintTop_toTopOf="@id/bottom_barrier"
        app:layout_constraintEnd_toEndOf="@id/bottom_barrier"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding"
        android:src = "@drawable/ic_hart"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"/>

    <TextView
        android:id="@+id/like_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/count_likes"
        android:textSize="12sp"
        android:textColor="#888"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@id/like"
        app:layout_constraintTop_toTopOf="@id/like"
        app:layout_constraintBottom_toBottomOf="@id/like" />

    <ImageButton
        android:id="@+id/repost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_repost"
        android:background="@android:color/transparent"
        android:contentDescription="@string/description_post_repost"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/like_count"
        app:layout_constraintTop_toTopOf="@id/like_count"
        app:layout_constraintBottom_toBottomOf="@id/like_count" />

    <TextView
        android:id="@+id/repost_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/count_reposts"
        android:textSize="12sp"
        android:textColor="#888"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@id/repost"
        app:layout_constraintTop_toTopOf="@id/repost"
        app:layout_constraintBottom_toBottomOf="@id/repost" />

    <ImageView
        android:id="@+id/views"
        android:contentDescription="@string/description_post_views"
        app:layout_constraintTop_toTopOf="@id/bottom_barrier"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding"
        android:layout_marginEnd="30dp"
        android:src = "@drawable/ic_eye"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"/>

    <TextView
        android:id="@+id/views_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/count_views"
        android:textSize="12sp"
        android:textColor="#888"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@id/views"
        app:layout_constraintTop_toTopOf="@id/views"
        app:layout_constraintBottom_toBottomOf="@id/views"
        />


    </androidx.constraintlayout.widget.ConstraintLayout>